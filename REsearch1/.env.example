# ── REsearch1 — copy this to .env (never commit .env) ─────────
# cp .env.example .env   (REsearch1 runs gitignored .env; this file is the template)

# Required: OpenAI key used ONLY by the backend proxy (server.js), never in frontend JS.
OPENAI_API_KEY=sk-your-openai-key-here

# Semantic search (embeddings) — used by POST /api/semantic
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Web-browse search — "ChatGPT 5.6 Luna" browsing for Zillow / Realtor / Redfin listings
# If your account lists it as a different id, put the exact id here.
OPENAI_BROWSE_MODEL=chatgpt-5.6-luna
# Fallback if the Luna model id is unavailable on your account:
OPENAI_BROWSE_FALLBACK_MODEL=gpt-4o

# Backend proxy
SEARCH_API_PORT=8787
SEARCH_API_HOST=127.0.0.1
# Comma-separated origins allowed to call the proxy (the static page origin)
SEARCH_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8787,http://localhost:8787
# Max browse results to return to the page
SEARCH_BROWSE_MAX_RESULTS=8
